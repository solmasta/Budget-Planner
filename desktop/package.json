{
  "name": "budget-planner-desktop",
  "version": "1.0.1",
  "description": "Budget Planner packaged as a desktop app",
  "private": true,
  "author": "Budget Planner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.budgetplanner.desktop",
    "productName": "Budget Planner",
    "publish": {
      "provider": "github",
      "owner": "solmasta",
      "repo": "Budget-Planner",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      { "from": "../index.html", "to": "app/index.html" },
      { "from": "../sw.js", "to": "app/sw.js" }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Finance"
    }
  }
}
